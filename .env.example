# Local development only. Production project/ports are selected during E08.
COMPOSE_PROJECT_NAME=fillable-local
FILLABLE_DEV_PORT=8180
FILLABLE_UPSTREAM_PORT=8181
DOCUMENTS_HOST_PATH=./var/storage
# Only for isolated local development. Use a distinct private value in production.
POSTGRES_PASSWORD=local-development-only

FILLABLE_PUBLIC_ORIGIN=http://127.0.0.1:8180

# Operational storage bounds, shared by API and worker. Bytes are exact integers.
STORAGE_FILE_BYTES=10485760
STORAGE_STAGING_BYTES=67108864
STORAGE_DISK_HEADROOM_BYTES=67108864
STORAGE_LEASE_SECONDS=60
