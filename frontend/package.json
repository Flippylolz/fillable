{
  "name": "fillable-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/editor-notices.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/editor-notices.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --coverage",
    "check:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "generate:api": "openapi-typescript generated/openapi.json -o generated/api.d.ts",
    "lint": "eslint src",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "i18next": "26.4.3",
    "openapi-fetch": "0.17.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
