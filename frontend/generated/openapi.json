{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "enum": [
              "authentication_required",
              "invalid_credentials",
              "forbidden",
              "rate_limited",
              "account_exists",
              "dependencies_unavailable",
              "not_found",
              "method_not_allowed",
              "invalid_request",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "code"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "LoginInput": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "SessionInfo": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "UserInfo": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "ui_language": {
            "enum": [
              "uk",
              "en"
            ],
            "title": "Ui Language",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "ui_language"
        ],
        "title": "UserInfo",
        "type": "object"
      }
    }
  },
